{
  "schema_version": 1,
  "frozen_on": "2026-11-28",
  "description": "Frozen rank-64 gain/forget controller semantics for the Inkling2 cross-pass message mix, grounded in the fork graph.",
  "scope": "gate semantics only, no timing",
  "note": "gate semantics only, no timing",
  "speed_claim": null,
  "gate_rank": 64,
  "n_embd": 2304,
  "down_shape": [64, 4608],
  "gain_shape": [2304, 64],
  "forget_shape": [2304, 64],
  "dtype": "F32",
  "eps": 1e-06,
  "formula": "(1-forget)*cur + gain*message",
  "op_sequence": [
    "rms_norm(cur, 1e-6) and rms_norm(message, 1e-6)",
    "concat(norm_cur, norm_message, axis=0)",
    "gate = down_weight @ concat",
    "gain = tanh(gain_weight @ gate) and forget = tanh(forget_weight @ gate)",
    "out = (1-forget)*cur + gain*message"
  ],
  "ctrl_streams": ["q", "k", "v", "ffn"],
  "ctrl_tensors": {
    "q": ["LOOP_Q_CTRL_DOWN", "LOOP_Q_CTRL_GAIN", "LOOP_Q_CTRL_FORGET"],
