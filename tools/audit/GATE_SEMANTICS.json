    "ffn": ["LOOP_FFN_CTRL_DOWN", "LOOP_FFN_CTRL_GAIN", "LOOP_FFN_CTRL_FORGET"]
  },
  "loop": {
    "core_start": 6,
    "core_end": 18,
    "num_passes": 3
  },
  "simplification": "local gamma softmax scalar is a simplification; the real gate is rank-64 with per-channel gain and forget",
